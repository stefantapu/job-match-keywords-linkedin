{
  "manifest_version": 3,
  "name": "LinkedIn Job Match Keywords",
  "version": "0.1.0",
  "description": "A compact LinkedIn Jobs sidebar for matching vacancy descriptions against positive and negative keywords.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.linkedin.com/jobs/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Job Match Keywords",
    "default_popup": "popup.html"
  }
}
